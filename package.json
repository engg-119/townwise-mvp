{
  "name": "townwise",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0", "npm": ">=11.10.0" },
  "workspaces": ["api", "api/kit/*", "client"],
  "scripts": {
    "lint": "export NODE_OPTIONS=--max-old-space-size=4096 && eslint client && eslint . --ignore-pattern 'client/**'",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "verify": "npm ls && npm run lint && npm run typecheck && npm test && npm run export:web --workspaces --if-present && EXPO_DOCTOR_SKIP_DEPENDENCY_VERSION_CHECK=1 npm run doctor --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
