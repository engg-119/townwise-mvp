# Raw data stays local (Kieran's Toast exports are private); only the README is tracked
data/*
!data/README.md

# Model outputs are built from those private exports, so they stay local too
modeling/outputs/

# Python / uv
.venv/
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Git worktrees for parallel branches (.worktrees/<branch>)
.worktrees/
# Claude Code's own worktrees (.claude/worktrees/<name>); the rest of .claude/ holds committed commands and skills
.claude/worktrees/

# Logs (Terraform's crash.log included) and tool caches
*.log
npm-debug.log*
.eslintcache
*.tsbuildinfo

# OS
.DS_Store

# Terraform: the one-time local-state override used before the state bucket exists (infra/README.md)
backend_override.tf

