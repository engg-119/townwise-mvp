# Non-secret production config for the API on Azure Container Apps. Every value here is public. The image
# (api/Dockerfile) starts node with --env-file=api/production.env; variables already in the environment win.
# The Container App (infra/terraform/production/containerapp.tf) sets the rest: the secrets MONGODB_URI,
# AUTH_JWT_KEYS and AUTH_ENCRYPTION_KEYS (and ANTHROPIC_API_KEY when enable_chat is on; GOOGLE_PLACES_API_KEY,
# GOOGLE_MAPS_STATIC_KEY and GOOGLE_MAPS_SIGNING_SECRET when enable_places is on) as Key Vault references, and
# REDIS_URL and NODE_EXTRA_CA_CERTS for the Valkey sidecar.
NODE_ENV=production
PORT=8080
# The Container Apps ingress proxy is the only hop in front of the API. It appends the client address as the
# rightmost X-Forwarded-For entry and connects from an internal address; Microsoft does not publish that
# range, so trust the private and shared address space (only this app and its own jobs run in the environment).
TRUST_PROXY=uniquelocal,100.64.0.0/10
CORS_ORIGINS=https://townwise.tech,https://www.townwise.tech
REDIS_KEY_PREFIX=townwise:
AUTH_ISSUER=https://api.townwise.tech
AUTH_MAGIC_LINK_URL=https://townwise.tech/auth/magic
AUTH_TOTP_ISSUER=Townwise
# Google OAuth client IDs, comma-separated: the web client, then the iOS client (the same values as the
# EXPO_PUBLIC_GOOGLE_* repository variables). Empty turns Google sign-in off.
AUTH_GOOGLE_CLIENT_IDS=789530597702-tej7u4q8idmaip2j5hrp3lvvinh32gvc.apps.googleusercontent.com
# Outbound email through Azure Communication Services (infra/terraform/production/email.tf), authenticated
# with the app's managed identity (AZURE_CLIENT_ID is set by the Container App). No API code sends yet;
# uncomment these when it does (values from the production outputs).
# EMAIL_ENDPOINT=https://<communication_service_endpoint>
# EMAIL_SENDER=no-reply@townwise.tech
# Townwise staff (superadmins): the Google sign-in addresses allowed into the staff console, comma-separated,
# at most 20. The API refuses to start in production while this is empty (api/src/config.ts).
TOWNWISE_SUPERADMIN_EMAILS=katie.j.sellu.th@dartmouth.edu,cameron.s.keith.gr@dartmouth.edu,marianna.cardin.th@dartmouth.edu,tejus.guddadaranganahalli.rajashekar.th@dartmouth.edu
# The tuning chat's monthly spend limit per organization, in US dollars (docs/portal/tuning-chat.md section 5).
TOWNWISE_CHAT_MONTHLY_BUDGET_USD=20
