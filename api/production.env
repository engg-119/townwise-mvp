# Non-secret production config for the API on Azure Container Apps. Every value here is public. The image
# (api/Dockerfile) starts node with --env-file=api/production.env; variables already in the environment win.
# The Container App (infra/terraform/production/containerapp.tf) sets the rest: the secrets MONGODB_URI,
# AUTH_JWT_KEYS, AUTH_ENCRYPTION_KEYS and TOWNWISE_CALENDAR_KEY (and ANTHROPIC_API_KEY when enable_chat is on;
# GOOGLE_PLACES_API_KEY, GOOGLE_MAPS_STATIC_KEY and GOOGLE_MAPS_SIGNING_SECRET when enable_places is on;
# TOWNWISE_GOOGLE_CALENDAR_CLIENT_SECRET when enable_google_calendar is on) as Key Vault references, and REDIS_URL
# and NODE_EXTRA_CA_CERTS for the Valkey sidecar.
NODE_ENV=production
PORT=8080
# The Container Apps ingress proxy is the only hop in front of the API. It appends the client address as the
# rightmost X-Forwarded-For entry and connects from an internal address; Microsoft does not publish that
# range, so trust the private and shared address space (only this app and its own jobs run in the environment).
TRUST_PROXY=uniquelocal,100.64.0.0/10
CORS_ORIGINS=https://townwise.tech,https://www.townwise.tech
REDIS_KEY_PREFIX=townwise:
AUTH_ISSUER=https://api.townwise.tech
AUTH_MAGIC_LINK_URL=https://townwise.tech/auth/magic
AUTH_TOTP_ISSUER=Townwise
# Google OAuth client IDs, comma-separated: the web client, then the iOS client (the same values as the
# EXPO_PUBLIC_GOOGLE_* repository variables). Empty turns Google sign-in off.
AUTH_GOOGLE_CLIENT_IDS=860102713029-3ifbvtlhjjp9m50u3caciqsokmemnhm7.apps.googleusercontent.com
# Google calendars (owners connect a location's Google calendars by signing in with Google): the web client id
# above, which must be one of AUTH_GOOGLE_CLIENT_IDS. Set at the runbook's "Google calendars" step (infra/README.md,
# step 22.4, 2026-11-17); Google calendars are on only while enable_google_calendar adds the client secret and
# TOWNWISE_CALENDAR_KEY is set too. Public value.
TOWNWISE_GOOGLE_CALENDAR_CLIENT_ID=860102713029-3ifbvtlhjjp9m50u3caciqsokmemnhm7.apps.googleusercontent.com
# Townwise's three emails (spec D14) through Azure Communication Services (infra/terraform/production/email.tf),
# sent with the app's managed identity (AZURE_CLIENT_ID from the Container App; IDENTITY_ENDPOINT and IDENTITY_HEADER
# from the platform). Email is on from the 2026-11-09 release (infra/README.md, step 9); the endpoint is
# terraform output -raw communication_service_endpoint. Comment out both lines together to turn it off.
EMAIL_ENDPOINT=https://acs-townwise-2d2c15bf.unitedstates.communication.azure.com
EMAIL_SENDER=no-reply@townwise.tech
# Reply-To on every Townwise email, so replies reach a person on the team (hello@townwise.tech has no mailbox).
TOWNWISE_EMAIL_REPLY_TO=cameron.s.keith.gr@dartmouth.edu
# The web app's origin, for the links in emails.
TOWNWISE_WEB_URL=https://townwise.tech
# Townwise staff (superadmins): the Google sign-in addresses allowed into the staff console, comma-separated,
# at most 20. The API refuses to start in production while this is empty (api/src/config.ts).
TOWNWISE_SUPERADMIN_EMAILS=katie.j.sellu.th@dartmouth.edu,cameron.s.keith.gr@dartmouth.edu,marianna.cardin.th@dartmouth.edu,tejus.guddadaranganahalli.rajashekar.th@dartmouth.edu,laura.a.ridlehoover@dartmouth.edu,eugene.santos.jr@dartmouth.edu
# The tuning chat's monthly spend limit per organization, in US dollars (docs/portal/tuning-chat.md section 5).
TOWNWISE_CHAT_MONTHLY_BUDGET_USD=20
# TownwiseAI's web search (spec D37). Web search must be on for the Anthropic organization in Claude Console, or every
# turn fails; false turns it off (infra/README.md, step 16, Web search). [CONFIRM: web search on in production; off by default in code]
TOWNWISE_CHAT_WEB_SEARCH=true
# TownwiseAI's weekly suggestions (openspec change weekly-forecast-suggestions), on by the owner's directive of
# 2026-11-16. Read by the weekly worker's job, which also needs ANTHROPIC_API_KEY for them to run: Terraform gives
# it the anthropic-api-key Key Vault reference while enable_chat is true (infra/terraform/production/jobs.tf). [DECISION NEEDED: the privacy page must say what weekly suggestions send before they run
# in production; the drafted sentence awaits the owner]
TOWNWISE_WEEKLY_SUGGESTIONS=true
# D59 (openspec change auto-apply-agent-reads): TownwiseAI working on its own (reading each stored file without a press
# and saving what it is sure of, with Undo) defaults to on in code. On 2026-11-19 the owner approved the privacy wording,
# chose on by default (owner question 1) and turned it on in production, not waiting on design decision 14's notice to
# Sawtooth's owner. An org admin can still turn it off for their organization on the TownwiseAI page.
TOWNWISE_AGENT_AUTO=true
# D66 (openspec change town-research-agent): the town research agent, on in code by default and on here since task 10.3:
# the live eval's ship gate passed on 2026-11-19 (docs/research/eval-2026-11-19.md) and the privacy page says what
# research sends, in the same release (design decision 16). It also needs ANTHROPIC_API_KEY and
# TOWNWISE_CHAT_WEB_SEARCH=true; false stops the runner and reads nothing researched.
TOWNWISE_RESEARCH=true
# D66 design decision 17: research's gather calls get web search only. The live eval showed no recall or grounding gain
# from web fetch, so it stays off (true would also need web fetch allowed for the organization in Claude Console).
TOWNWISE_RESEARCH_WEB_FETCH=false
# D66 design decision 10: research prompts carry the restaurant's Google name and address and up to 8 nearby
# restaurants, bars and cafes from Google (names, types and websites). Decided 2026-11-19 by the owner: allowed (asked
# whether Google Maps Platform's terms allow sending Places names, types and websites to Anthropic, the owner answered
# "yes that is allowed"). The code default stays false, so an environment that leaves it unset sends nothing Google
# answered.
TOWNWISE_RESEARCH_PLACES_TO_AI=true
# Stored files (docs/portal/spec.md 11A): the private client files account (infra/terraform/production/files.tf),
# reached only through its private endpoint, with the app's managed identity. On since the runbook's "Enable file
# storage" step (infra/README.md, step 18; applied 2026-11-15), with the drop screen and the privacy page's
# stored-files wording already live. Public value.
FILES_BLOB_ACCOUNT_URL=https://sttwfiles2d2c15bf.blob.core.windows.net
# The file reader's AI column step's monthly spend limit per organization, in US dollars (spec 11A.4); it runs only
# with stored files and ANTHROPIC_API_KEY both on.
TOWNWISE_FILES_MONTHLY_BUDGET_USD=5
# The weekly refresh of forecasts (spec D42, 14.6): on by default by the owner's directive (2026-11-16), written here
# so production says so. Only the weekly forecast worker reads it (the scheduled job caj-townwise-forecasts, which
# runs this image's api/src/workers/weekly-forecasts.ts hourly); it does nothing until the lab is enabled
# (infra/README.md, step 20). Forecasts are on for every organization by default, so from then on each location with
# enough history publishes a refreshed forecast weekly. false stops new scheduled calibrations at the next pass.
TOWNWISE_WEEKLY_FORECASTS=true
# Roughly how many scheduled calibrations may start in one week across all organizations, paid by Townwise.
TOWNWISE_WEEKLY_FORECAST_CAP=200
