# Local development. Copy to api/.env.local (gitignored) and fill the two keys.
NODE_ENV=development
PORT=8080
TRUST_PROXY=loopback
CORS_ORIGINS=http://localhost:8081
MONGODB_URI=mongodb://localhost:27017/townwise
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=townwise:
AUTH_ISSUER=http://localhost:8080
AUTH_MAGIC_LINK_URL=http://localhost:8081/auth/magic
AUTH_TOTP_ISSUER=Townwise
# kid:base64; generate a key with openssl rand -base64 32
AUTH_JWT_KEYS=
# kid:base64; generate a key with openssl rand -base64 32
AUTH_ENCRYPTION_KEYS=
# Google OAuth web client id(s), comma-separated. Empty turns Google sign-in off.
AUTH_GOOGLE_CLIENT_IDS=
# Townwise staff (superadmins), comma-separated. Empty is allowed in development; production refuses it.
TOWNWISE_SUPERADMIN_EMAILS=
# Staff two-step sign-in: required or off. Unset, it is off in development and required elsewhere; production refuses off.
TOWNWISE_STAFF_TWO_STEP=
# The tuning chat's Anthropic API key. Empty turns the chat off; never commit a real key.
ANTHROPIC_API_KEY=
# A Google Places (New) API key, for finding the business on the access request. Empty turns the Places search off
# (both routes answer 503); never commit a real key.
GOOGLE_PLACES_API_KEY=
# The map on the confirm card: a Google API key restricted to the Maps Static API, and the URL signing secret from the
# same Google Cloud project. The browser loads the signed map URL from Google, so the key is seen there; the secret
# never leaves the API. Both are needed: without either there is no map, never an unsigned one. Never commit real ones.
GOOGLE_MAPS_STATIC_KEY=
GOOGLE_MAPS_SIGNING_SECRET=
# The tuning chat's monthly spend limit per organization, in US dollars.
TOWNWISE_CHAT_MONTHLY_BUDGET_USD=20
# Townwise's emails (Azure Communication Services). Empty turns email off. EMAIL_ENDPOINT and EMAIL_SENDER go together.
# To send locally, run az login with an account that is Owner of, or holds "Townwise email sender" on, the
# Communication Services resource, and set EMAIL_ENDPOINT=https://acs-townwise-2d2c15bf.unitedstates.communication.azure.com
# and EMAIL_SENDER=no-reply@townwise.tech: the API then takes its token from your az login, and the emails really send.
EMAIL_ENDPOINT=
EMAIL_SENDER=
TOWNWISE_EMAIL_REPLY_TO=
TOWNWISE_WEB_URL=http://localhost:8081
# Stored files (spec 11A). Empty turns them off (every files route answers 503 files_unavailable). To try them
# locally, start Azurite (docker compose up -d) and set both: FILES_BLOB_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
# and FILES_AZURITE_CONNECTION_STRING=UseDevelopmentStorage=true. Production refuses the Azurite setting.
FILES_BLOB_ACCOUNT_URL=
FILES_AZURITE_CONNECTION_STRING=
# The file reader's AI column step's monthly spend limit per organization, in US dollars (spec 11A.4); 0 turns it off,
# and it runs only with ANTHROPIC_API_KEY.
TOWNWISE_FILES_MONTHLY_BUDGET_USD=5
# The key that seals owner calendar links (subscription addresses) in the database: 32 random bytes in base64, made with
# openssl rand -base64 32. Unset turns calendar links off (adding one answers 503 calendar_links_unavailable) while
# calendar files still import; anything else refuses boot. A link sealed under one key opens under no other, so changing
# it means adding every link again. Never commit a real key.
# TOWNWISE_CALENDAR_KEY=
# The forecast lab (calibrations): off, local or azure. Off answers 503 lab_unavailable. local runs the lab's job with uv
# (installed separately) in TOWNWISE_LAB_PROJECT_DIR (default ../modeling/lab) and needs TOWNWISE_LAB_API_URL, the origin
# the job calls back on: this API's, http://localhost:8080. azure is production's: TOWNWISE_LAB_JOB_ID is the Container
# Apps job's resource id, and TOWNWISE_LAB_AUDIENCE, TOWNWISE_LAB_CALLER_ID and TOWNWISE_LAB_TENANT_ID say whose Entra
# token the callback accepts (the lab callback app, the lab identity, the tenant); Terraform sets all four. Leave them
# empty locally: a local job calls back with a secret this process makes.
TOWNWISE_LAB_RUNNER=off
TOWNWISE_LAB_API_URL=
TOWNWISE_LAB_JOB_ID=
TOWNWISE_LAB_PROJECT_DIR=
