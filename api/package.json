    "@azure/storage-blob": "12.33.0",
    "@ckeith26/auth": "file:./kit/auth",
    "@ckeith26/mongo": "file:./kit/mongo",
    "@ckeith26/rate-limit": "file:./kit/rate-limit",
    "@ckeith26/redis": "file:./kit/redis",
    "@ckeith26/server-core": "file:./kit/server-core",
    "express": "5.3.0",
    "jose": "6.2.12",
    "mongoose": "9.11.2",
    "read-excel-file": "9.3.14",
    "saxen": "11.2.0",
    "unpdf": "2.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "12.2.1",
    "@types/express": "5.0.6",
    "testcontainers": "12.2.1",
    "vitest": "5.0.5"
