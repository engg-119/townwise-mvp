{
  "name": "@townwise/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration"
  },
  "dependencies": {
    "@ckeith26/auth": "file:../backend/auth",
    "@ckeith26/mongo": "file:../backend/mongo",
    "@ckeith26/rate-limit": "file:../backend/rate-limit",
    "@ckeith26/redis": "file:../backend/redis",
    "@ckeith26/server-core": "file:../backend/server-core",
    "express": "5.3.0",
    "mongoose": "9.11.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "12.2.1",
    "@types/express": "5.0.6",
    "testcontainers": "12.2.1",
    "vitest": "5.0.5"
  }
}
