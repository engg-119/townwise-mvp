{
  "name": "@ckeith26/expo-shell",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc -p . --noEmit",
    "test": "jest --ci",
    "test:unit": "jest --ci",
    "export:web": "expo export --platform web --output-dir .expo-export && node scripts/check-web-export.mts .expo-export",
    "doctor": "expo-doctor",
    "verify": "npm run typecheck && npm test && npm run export:web && npm run doctor"
  },
  "jest": {
    "projects": [
      {
        "displayName": "native",
        "preset": "jest-expo/ios"
      },
      {
        "displayName": "web",
        "preset": "jest-expo/web",
        "moduleNameMapper": {
          "^@react-native/assets-registry/registry(\\.js)?$": "react-native-web/asset-registry"
        }
      }
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.14",
    "@react-native-google-signin/google-signin": "16.1.5",
    "expo": "58.0.13",
    "expo-constants": "58.0.13",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.9",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.22",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.10",
    "libheif-js": "1.23.5",
    "markdown-it": "14.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "expo-doctor": "1.21.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}
