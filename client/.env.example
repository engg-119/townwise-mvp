# Every EXPO_PUBLIC_* value is compiled into the app and readable by anyone. Never put a secret here.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_URL=
# Empty: npm start reads Key Vault secret google-web-client-id. Azure is contacted only when this is empty.
# A value here overrides it. The client secret is not set here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
