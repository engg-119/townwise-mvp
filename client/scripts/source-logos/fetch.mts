// Fetches the logo of every site the shipped sources cite, once, for the source chips (README.md here). Run by hand,
// never in CI or at build; what it writes (client/assets/sources/{host}.png and client/src/portal/sources/logos.ts) is
// committed and reviewed, and nothing fetches a logo at view time.
// - Every run first scans the shipped source data for https URLs and finds each host's entry in sites.json: the host
//   without www., then its parent domains down to two labels, as src/portal/sources/site.ts looks a source up. A host
//   with no entry fails the run, naming it, before anything is written.
// - --check stops there, and also fails when logos.ts is not what sites.json and the logo files on disk make (an entry
//   left out or misnamed, a logo file missing), with no network. test/scripts/source-logos.test.ts runs it.
// - --manifest writes logos.ts from sites.json and the logo files on disk, with no network: after a logo that is not
//   the site's has been deleted by hand, so that site shows its parent site's logo or the globe.
// - Otherwise each site's home page is read once (https://{host}/, or https://www.{host}/ when that fails; a generic
//   User-Agent, a 10 second timeout, at most 256 KB, enough for the head of a long page), then the first PNG among its
//   apple-touch-icon links, its PNG icon links, the ICO files its icon links name and its /favicon.ico (an ICO's largest
//   PNG entry) is kept (icons.ts). SVG, BMP, JPEG and anything else is refused, and so is an icon over 64 KB.
// - In logos.ts a site with no logo of its own takes its nearest parent site's (registrar.dartmouth.edu shows
//   dartmouth.edu's), and a site with neither shows the globe.
import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

import type * as Icons from './icons';

interface Site { host: string; name: string }

const here = dirname(fileURLToPath(import.meta.url));
const client = resolve(here, '../..');
const repo = resolve(client, '..');
const ASSETS = join(client, 'assets/sources');
const MANIFEST = join(client, 'src/portal/sources/logos.ts');
/** The shipped source data: the API's town calendar and town profiles, and the bundled files src/portal/towns.ts reads. */
const SCANNED = [
  'api/src/town-calendar-data.ts', 'api/src/town-profiles.ts', 'api/src/town-calendar.ts',
  'client/src/marketing/map/towns.ts', 'client/src/marketing/map/countyData.ts',
];
const URL_PATTERN = /https:\/\/[^\s'"`<>()]+/g;
const PAGE_CAP = 256 * 1024;
const ICON_CAP = 64 * 1024;
const TIMEOUT_MS = 10_000;
const USER_AGENT = 'logo-fetcher/1.0';

const sites = (JSON.parse(readFileSync(join(here, 'sites.json'), 'utf8')) as Site[]).toSorted((a, b) => a.host.localeCompare(b.host));
const byHost = new Map(sites.map((site) => [site.host, site]));

/** A host without www., then its parent domains down to two labels: home.dartmouth.edu, dartmouth.edu. */
function domainsOf(host: string): string[] {
  const labels = host.replace(/^www\./, '').split('.');
  return labels.slice(0, -1).map((_, at) => labels.slice(at).join('.'));
}

/** A host's site: the first of its domains with an entry in sites.json. */
function siteOf(host: string): Site | undefined {
  return domainsOf(host).map((domain) => byHost.get(domain)).find((site) => site !== undefined);
}

const cited = new Set(SCANNED.flatMap((file) => [...readFileSync(join(repo, file), 'utf8').matchAll(URL_PATTERN)].map((match) => new URL(match[0]).hostname)));
const missing = [...cited].filter((host) => siteOf(host) === undefined).sort();
if (missing.length > 0) {
  console.error(`No entry in scripts/source-logos/sites.json for ${missing.join(', ')}: add each with the name a person would say.`);
  process.exit(1);
}

/** A host as an identifier: registrar.dartmouth.edu is registrarDartmouthEdu. */
function identifier(host: string): string {
  const words = host.split(/[^a-z0-9]+/i).filter((word) => word !== '');
  const name = words.map((word, at) => (at === 0 ? word : `${word.charAt(0).toUpperCase()}${word.slice(1)}`)).join('');
  return /^\d/.test(name) ? `site${name}` : name;
}

const quoted = (text: string): string => `'${text.replaceAll('\\', '\\\\').replaceAll('\'', '\\\'')}'`;

/** logos.ts as sites.json and the logo files on disk make it. */
function manifest(): string {
  const logos = sites.filter((site) => existsSync(join(ASSETS, `${site.host}.png`)));
  /** The site's own logo, else its nearest parent site's, as the host whose file it is. */
  const logoOf = (site: Site): string | undefined => domainsOf(site.host).find((domain) => logos.some((logo) => logo.host === domain));
  return [
    '// Generated by scripts/source-logos/fetch.mts, do not edit: change sites.json and run the script again (README.md there).',
    'import type { ImageSourcePropType } from \'react-native\';',
    '',
    ...logos.map((site) => `import ${identifier(site.host)} from ${quoted(`../../../assets/sources/${site.host}.png`)};`),
    '',
    '/** A cited site: the name its source chip shows, and its committed logo, or null for the globe. */',
    'export interface SiteEntry { name: string; logo: ImageSourcePropType | null }',
    '',
    '/** Every site the shipped sources cite, by host without www. (src/portal/sources/site.ts looks a source up). */',
    'export const SITES: Readonly<Record<string, SiteEntry>> = {',
    ...sites.map((site) => {
      const logo = logoOf(site);
      return `  ${quoted(site.host)}: { name: ${quoted(site.name)}, logo: ${logo === undefined ? 'null' : identifier(logo)} },`;
    }),
    '};',
    '',
  ].join('\n');
}

if (process.argv.includes('--check')) {
  if (!existsSync(MANIFEST) || readFileSync(MANIFEST, 'utf8') !== manifest()) {
    console.error('src/portal/sources/logos.ts is not what sites.json and assets/sources make: run fetch.mts --manifest, or fetch.mts.');
    process.exit(1);
  }
  console.log(`source logos: ${String(cited.size)} cited hosts, ${String(sites.length)} sites, the manifest matches.`);
  process.exit(0);
}

if (process.argv.includes('--manifest')) {
  mkdirSync(dirname(MANIFEST), { recursive: true });
  writeFileSync(MANIFEST, manifest());
  console.log('wrote src/portal/sources/logos.ts');
  process.exit(0);
}

const icons = (await import(pathToFileURL(resolve(here, 'icons.ts')).href)) as typeof Icons;

/** A response's bytes, at most `cap` of them, with its final URL; `complete` is false when the cap cut it short. */
async function read(url: string, cap: number): Promise<{ bytes: Uint8Array; url: string; complete: boolean } | null> {
  try {
    const response = await fetch(url, { headers: { 'User-Agent': USER_AGENT }, signal: AbortSignal.timeout(TIMEOUT_MS) });
    if (!response.ok || response.body === null) return null;
    const reader = response.body.getReader();
    const chunks: Uint8Array[] = [];
    let size = 0;
    let complete = false;
    for (;;) {
      const chunk = await reader.read();
      if (chunk.done) {
        complete = true;
        break;
      }
      chunks.push(chunk.value);
      size += chunk.value.length;
      if (size > cap) {
        await reader.cancel();
        break;
      }
    }
    const bytes = new Uint8Array(Math.min(size, cap));
    let at = 0;
    for (const chunk of chunks) {
      const part = chunk.subarray(0, bytes.length - at);
      bytes.set(part, at);
      at += part.length;
    }
    return { bytes, url: response.url, complete };
  } catch {
    return null;
  }
}

/** The first PNG among the page's icon links and its /favicon.ico, with the URL it came from. */
async function fetchLogo(site: Site): Promise<{ png: Uint8Array; from: string } | null> {
  const home = `https://${site.host}/`;
  const page = (await read(home, PAGE_CAP)) ?? (await read(`https://www.${site.host}/`, PAGE_CAP));
  const links = page === null ? [] : icons.iconLinks(new TextDecoder().decode(page.bytes), page.url);
  for (const url of new Set([...links, new URL('/favicon.ico', page?.url ?? home).href])) {
    const icon = await read(url, ICON_CAP);
    const png = icon?.complete === true ? icons.pngOf(icon.bytes) : null;
    if (png !== null) return { png, from: url };
  }
  return null;
}

mkdirSync(ASSETS, { recursive: true });
mkdirSync(dirname(MANIFEST), { recursive: true });
for (const file of readdirSync(ASSETS)) {
  if (!byHost.has(file.replace(/\.png$/, ''))) rmSync(join(ASSETS, file));
}
for (const site of sites) {
  const logo = await fetchLogo(site);
  const file = join(ASSETS, `${site.host}.png`);
  if (logo === null) rmSync(file, { force: true });
  else writeFileSync(file, logo.png);
  console.log(`${site.host}: ${logo === null ? 'no PNG icon, the globe' : `${logo.from} (${String(logo.png.length)} bytes)`}`);
}
writeFileSync(MANIFEST, manifest());
console.log('wrote src/portal/sources/logos.ts');
